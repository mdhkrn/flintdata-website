# Public build-time settings (values here end up in the site's JavaScript).

# Google Apps Script web app URL that writes contact requests to the
# "Flint Business Requests" sheet. Setup: google-apps-script/README.md.
# While empty, the form shows an error on submit.
VITE_CONTACT_ENDPOINT=https://script.google.com/macros/s/AKfycby74I6aDvskPAz7qnCu-E-3jJJ0CtpIpni65BcCoI4VKe9wgCCCmVrH6eOHkcgDV6E57A/exec
